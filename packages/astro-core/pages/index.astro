---
import { config } from "virtual:agency/site";
import Layout from "../components/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import Services from "../components/sections/Services.astro";
import About from "../components/sections/About.astro";
import Team from "../components/sections/Team.astro";
import Gallery from "../components/sections/Gallery.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import Hours from "../components/sections/Hours.astro";
import Faq from "../components/sections/Faq.astro";
import Contact from "../components/sections/Contact.astro";

const sections = {
  hero: Hero, services: Services, about: About, team: Team, gallery: Gallery,
  testimonials: Testimonials, hours: Hours, faq: Faq, contact: Contact,
};
---
<Layout>
  {config.home.map((name) => { const Section = sections[name]; return <Section />; })}
</Layout>
