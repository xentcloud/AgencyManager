{
  "name": "@agency/astro-core",
  "version": "0.1.0",
  "description": "Shared Astro integration for agency client sites: layouts, sections, SEO, analytics and agency credit.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./components/*": "./components/*",
    "./pages/*": "./pages/*",
    "./styles/*": "./styles/*",
    "./virtual": { "types": "./virtual.d.ts" }
  },
  "files": ["dist", "components", "pages", "styles", "virtual.d.ts"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agency/site-schema": "workspace:^",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "astro": "^7.3.6",
    "typescript": "^5.9.3"
  }
}
