---
import { team } from "virtual:agency/site";
---
{team.length > 0 && (
  <section id="team" class="section">
    <div class="container">
      <h2>Meet the team</h2>
      <ul class="cards">
        {team.map((m) => (
          <li class="card person">
            {m.photo && <img src={m.photo.src} alt={m.photo.alt} loading="lazy" />}
            <h3>{m.name}</h3>
            <p class="muted">{m.role}</p>
            {m.bio && <p>{m.bio}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
