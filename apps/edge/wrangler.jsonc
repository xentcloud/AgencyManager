{
  // Shared multi-tenant edge Worker for all client sites:
  //   POST /f/<siteId>   contact/booking form submissions
  //   email()            inbound email (Cloudflare Email Routing) for change requests & replies
  "name": "agency-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    "CONVEX_SITE_URL": "http://127.0.0.1:3211"
  },
  // Secrets: EDGE_SHARED_SECRET (HMAC to Convex), TURNSTILE_SECRET_KEY
  "ratelimits": [
    { "name": "FORM_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
